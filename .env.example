# VoiceDrift settings. Copy this file to .env and fill it in; .env is ignored by git, so secrets stay on this machine.

# --- Database ------------------------------------------------------------------------------------
# PostgreSQL in Docker: `docker compose up -d db` creates it from these four values.
POSTGRES_USER=voicedrift
POSTGRES_PASSWORD=change-me
POSTGRES_DB=voicedrift
POSTGRES_PORT=5433
# What the backend connects to (127.0.0.1, not localhost: Docker publishes the port on IPv4 only, and
# "localhost" would first wait for an IPv6 timeout). To use a local SQLite file instead (no Docker):
# DATABASE_URL=sqlite:///backend/data/dashboard.db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Email: every finished voice check is emailed to its owner -----------------------------------
# smtp: send through the SMTP server below.  outbox: save the emails in backend/data/outbox/ instead.
EMAIL_BACKEND=smtp
# Must be a sender verified with your SMTP provider (Brevo > Senders, Domains & Dedicated IPs > Senders).
EMAIL_FROM=VoiceDrift <you@example.com>
# Brevo > SMTP & API > SMTP tab. Port 587 + STARTTLS = encrypted connection.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
# The "Login" shown on that page.
SMTP_USERNAME=
# An SMTP key generated on that page (starts with xsmtpsib-), not the API key.
SMTP_PASSWORD=

# --- Web app and ports (optional) ----------------------------------------------------------------
# The Next.js app (frontend/): email links point here, and the API accepts its requests.
# FRONTEND_URL=http://localhost:3000
# DASHBOARD_PORT=8700
# PHONE_PORT=8443

# --- Voice checker -------------------------------------------------------------------------------
# Research datasets (SVD, TORGO, LibriSpeech): about 10 GB, kept outside the repository.
DATASETS_DIR=E:/VoiceDrift-data
# Optional: a friendlier Claude-written summary in the Streamlit drift tracker.
# ANTHROPIC_API_KEY=
